VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Gemini API key는 더 이상 클라이언트에 두지 않습니다.
# Supabase Edge Function(gemini-proxy)의 secret로만 관리:
#   supabase secrets set GEMINI_API_KEY=...

# 토스페이먼츠 — 클라이언트 키(공개 가능, 결제창용). 발급 후 채우기.
#   서버 시크릿(TOSS_SECRET_KEY)은 payments 함수에:
#   supabase secrets set TOSS_SECRET_KEY=...
VITE_TOSS_CLIENT_KEY=your_toss_client_key

# 테스트(목) 결제 모드 — true 면 토스 없이 결제 성공 처리(잠금해제 플로우 검증용).
#   반드시 서버 시크릿과 짝으로 켤 것: supabase secrets set MOCK_PAYMENTS=true
#   ⚠️ 실서비스 전 반드시 둘 다 끄기(false/미설정).
VITE_PAYMENTS_MOCK=false
